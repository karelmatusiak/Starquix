---
/**
 * @category Header
 * @theme classic
 * @name Header
 */
---
<header class="bg-stone-50 shadow-sm px-16 py-3 h-min">
  <nav class='px-4'>
    <div
      class='flex space-x-4 justify-between items-center'
    >
      <div class='flex items-center w-24'>
        <img
          class='h-8 w-auto'
          src='/assets/logos/logo-placeholder.svg'
          alt='Logo'
        />
      </div>
      <div
        class='flex space-x-10 flex-auto justify-center'
      >
        <a
          href='#'
          class='text-stone-800 hover:text-stone-500 transition-colors duration-100'
        >
          Co pečeme
        </a>
        <a
          href='#'
          class='text-stone-800 hover:text-stone-500 transition-colors duration-100'
        >
          Nabídka
        </a>
        <a
          href='#'
          class='text-stone-800 hover:text-stone-500 transition-colors duration-100'
        >
          Pekaři
        </a>
        <a
          href='#'
          class='text-stone-800 hover:text-stone-500 transition-colors duration-100'
        >
          Novinky
        </a>
        <a
          href='#'
          class='text-stone-800 hover:text-stone-500 transition-colors duration-100'
        >
          Ceník
        </a>
      </div>
      <div class='flex space-x-2'>
        <button
          class='whitespace-nowrap text-stone-800 text-sm font-semibold bg-transparent border border-stone-200 hover:bg-stone-100 transition-colors duration-100 py-2 px-5 rounded-md'
        >
          Zastavte se na kávu
        </button>
        <button
          class='whitespace-nowrap text-stone-800 text-sm font-semibold bg-yellow-400 hover:bg-yellow-500 transition-colors duration-100 py-2 px-5 rounded-md'
        >
          Zastavte se na kávu
        </button>
      </div>
    </div>
  </nav>
</header>
