---
/**
 * @category Team
 * @theme classic
 * @name Team2
 */
---
<section
  class='bg-stone-50 px-2 py-8 flex flex-col gap-4 sm:px-4 sm:py-12 sm:gap-8 md:px-8 md:py-16 lg:px-16 lg:py-10'
>
  <div class='px-0 sm:px-4'>
    <h2
      class='text-stone-800 font-sans text-2xl font-bold text-center leading-tight tracking-tight sm:text-3xl sm:leading-tight md:text-4xl md:leading-none md:tracking-[-0.02em] lg:text-5xl lg:leading-none lg:tracking-[-1.44px]'
    >
      Náš tým
    </h2>
  </div>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-4 md:grid-cols-3 md:gap-x-8 md:gap-y-4'>
    <div class='p-2 sm:p-4'>
      <div class='bg-white rounded-lg overflow-auto'>
        <img
          src='/assets/userpics/userpic07.webp'
          class='w-full h-auto aspect-square'
          alt='Radka Tomanová'
        />
        <div class='flex flex-col px-4 py-3 sm:px-6 sm:py-4'>
          <p
            class='text-stone-800 text-center font-semibold text-base sm:text-lg'
          >
            Riley Thompson
          </p>
          <p
            class='text-stone-500 text-center text-sm sm:text-base'
          >
            Majitelka, Pekárna Na Růžku
          </p>
          <a
            class='text-sky-500 text-center text-sm sm:text-base'
            href='#'>@pekarnanaruzku</a
          >
        </div>
      </div>
    </div>
    <div class='p-4'>
      <div class='bg-white rounded-lg overflow-auto'>
        <img
          src='/assets/userpics/userpic08.webp'
          class='w-full h-auto aspect-square'
          alt='Jitka Linhartová'
        />
        <div class='flex flex-col px-6 py-4'>
          <p
            class='text-stone-800 text-center font-semibold text-lg'
          >
            Jordana Lee
          </p>
          <p
            class='text-stone-500 text-center text-base'
          >
            Provozní, Pekárna Na Růžku
          </p>
          <a
            class='text-sky-500 text-center text-base'
            href='#'>@pekarnanaruzku</a
          >
        </div>
      </div>
    </div>
    <div class='p-4'>
      <div class='bg-white rounded-lg overflow-auto'>
        <img
          src='/assets/userpics/userpic09.webp'
          class='w-full h-auto aspect-square'
          alt='Alena Krejčí'
        />
        <div class='flex flex-col px-6 py-4'>
          <p
            class='text-stone-800 text-center font-semibold text-lg'
          >
            Alena Krejčí
          </p>
          <p
            class='text-stone-500 text-center text-base'
          >
            Pekař, Pekárna Na Růžku
          </p>
          <a
            class='text-sky-500 text-center text-base'
            href='#'>@pekarnanaruzku</a
          >
        </div>
      </div>
    </div>
    <div class='p-4'>
      <div class='bg-white rounded-lg overflow-auto'>
        <img
          src='/assets/userpics/userpic10.webp'
          class='w-full h-auto aspect-square'
          alt='Karolína Moravcová'
        />
        <div class='flex flex-col px-6 py-4'>
          <p
            class='text-stone-800 text-center font-semibold text-lg'
          >
            Karolína Moravcová
          </p>
          <p
            class='text-stone-500 text-center text-base'
          >
            Cukrářka, Pekárna Na Růžku
          </p>
          <a
            class='text-sky-500 text-center text-base'
            href='#'>@pekarnanaruzku</a
          >
        </div>
      </div>
    </div>
    <div class='p-4'>
      <div class='bg-white rounded-lg overflow-auto'>
        <img
          src='/assets/userpics/userpic11.webp'
          class='w-full h-auto aspect-square'
          alt='Tereza Brožová'
        />
        <div class='flex flex-col px-6 py-4'>
          <p
            class='text-stone-800 text-center font-semibold text-lg'
          >
            Taylor Brooks
          </p>
          <p
            class='text-stone-500 text-center text-base'
          >
            Majitel, Bistro Pod Hradem
          </p>
          <a
            class='text-sky-500 text-center text-base'
            href='#'>@pekarnanaruzku</a
          >
        </div>
      </div>
    </div>
    <div class='p-4'>
      <div class='bg-white rounded-lg overflow-auto'>
        <img
          src='/assets/userpics/userpic12.webp'
          class='w-full h-auto aspect-square'
          alt='Sabina Pavlová'
        />
        <div class='flex flex-col px-6 py-4'>
          <p
            class='text-stone-800 text-center font-semibold text-lg'
          >
            Sydney Patel
          </p>
          <p
            class='text-stone-500 text-center text-base'
          >
            Provozní, Kavárna U Nádraží
          </p>
          <a
            class='text-sky-500 text-center text-base'
            href='#'>@pekarnanaruzku</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
