---
/**
 * @category Pricing
 * @theme classic
 * @name Pricing
 */
---
<section
  class='bg-stone-50 px-16 py-10 flex flex-col gap-8 h-min'
>
  <div class='grid grid-cols-12 gap-8'>
    <div
      class='col-span-3 px-4 border-r border-stone-200'
    >
      <h2
        class='text-5xl text-stone-800 font-semibold tracking-[-2%]'
      >
        Vyberte si plán
      </h2>
      <p
        class='text-sm text-stone-500 mt-4'
      >
        14 dní na zkoušku, pak od 750&nbsp;Kč&nbsp;/&nbsp;měsíc.
      </p>
    </div>
    <div class='col-span-3 px-4 pt-4 pb-5 rounded-lg'>
      <h3
        class='text-2xl text-stone-500 font-semibold tracking-[-2%]'
      >
        Základ
      </h3>
      <p
        class='text-sm text-stone-500 mt-7'
      >
        $ <span
          class='text-6xl font-light text-stone-800 tracking-tight'>75</span
        > / měsíc.
      </p>
      <p
        class='text-sm text-stone-500 mt-4'
      >
        účtováno <span
          class='line-through'>$1188</span
        > 9 000 Kč / rok.
      </p>
      <p
        class='text-sm text-stone-500'
      >
        sleva 32 %
      </p>
      <button
        class='flex justify-center items-center w-full px-5 py-2.5 mt-6 bg-yellow-400 text-sm text-stone-800 font-semibold rounded-md hover:bg-yellow-500 transition-colors duration-100'
      >
        Vzít chleba
      </button>
    </div>
    <div
      class='col-span-3 px-4 bg-sky-100 pt-4 pb-5 rounded-lg'
    >
      <h3
        class='text-2xl text-sky-600 font-semibold tracking-[-2%]'
      >
        Pro firmy
      </h3>
      <p
        class='text-sm text-sky-800 mt-7'
      >
        $ <span
          class='text-6xl font-light text-sky-950 tracking-tight'>199</span
        > / měsíc.
      </p>
      <p
        class='text-sm text-sky-500 font-semibold mt-4'
      >
        účtováno <span
          class='line-through'>$2988</span
        > 23 900 Kč / rok.
      </p>
      <div
        class='whitespace-nowrap flex justify-center w-min items-center bg-sky-500 px-1 rounded-sm'
      >
        <span
          class='text-sky-50 text-sm font-semibold'>sleva 25 %</span
        >
      </div>
      <button
        class='flex justify-center items-center w-full px-5 py-2.5 mt-6 bg-yellow-400 text-sm text-stone-800 font-semibold rounded-md hover:bg-yellow-500 transition-colors duration-100'
      >
        Vzít chleba
      </button>
    </div>
    <div class='col-span-3 px-4 pt-4 pb-5 rounded-lg'>
      <h3
        class='text-2xl text-stone-500 font-semibold tracking-[-2%]'
      >
        Základ
      </h3>
      <p
        class='text-sm text-stone-500 mt-7'
      >
        $ <span
          class='text-6xl font-light text-stone-800 tracking-tight'>499</span
        > / měsíc.
      </p>
      <p
        class='text-sm text-stone-500 mt-4'
      >
        účtováno <span
          class='line-through'>$7188</span
        > 48 000 Kč / rok.
      </p>
      <p
        class='text-sm text-stone-500'
      >
        sleva 20 %
      </p>
      <button
        class='flex justify-center items-center w-full px-5 py-2.5 mt-6 bg-yellow-400 text-sm text-stone-800 font-semibold rounded-md hover:bg-yellow-500 transition-colors duration-100'
      >
        Vzít chleba
      </button>
    </div>
  </div>
</section>
