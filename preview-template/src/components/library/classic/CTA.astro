---
/**
 * @category CTA
 * @theme classic
 * @name CTA
 */
---
<section class="bg-white px-16 pt-10 pb-20">
  <div
    class="flex flex-row justify-between items-end px-4 bg-transparent"
  >
    <h2
      class='text-6xl text-stone-800 font-semibold tracking-tight'
    >
      Otevřeno od 6.30, chléb ještě teplý
    </h2>
    <button
      class='flex justify-center h-min px-5 py-2.5 bg-yellow-400 text-sm text-stone-800 font-semibold rounded-md hover:bg-yellow-500 transition-colors duration-100'
    >
      Vzít chleba
    </button>
  </div>
  <div class='px-4 mt-10'>
    <img
      class='w-full rounded-lg'
      data-testid='cta-image'
      src='/assets/images/content/cta.webp'
      alt=''
    />
  </div>
</section>
