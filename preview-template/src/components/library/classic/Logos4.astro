---
/**
 * @category Logos
 * @theme classic
 * @name Logos4
 */
---
<section
  class='py-16 px-16 grid grid-cols-12 gap-8 h-min bg-stone-50'
>
  <div class='col-start-1 col-end-13'>
    <h2
      class='w-full text-center text-2xl font-semibold text-gray-800'
    >
      Pečeme pro lidi z okolí
    </h2>
    <p
      class='w-full text-center text-xl text-gray-500'
    >
      Od sousedů z ulice po celou čtvrť
    </p>
    <div class='w-full columns-4 gap-8 mt-4'>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Coastline.svg'
          alt='Výlety Na Nábřeží'
          class='w-full'
        />
      </div>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Kettle.svg'
          alt='Čajovna Konvice'
          class='w-full'
        />
      </div>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Nordvik.svg'
          alt='Statek Severák'
          class='w-full'
        />
      </div>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Halden.svg'
          alt='Keramika Hrádek'
          class='w-full'
        />
      </div>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Lumen.svg'
          alt='Studio Lumen'
          class='w-full'
        />
      </div>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/PaperHarbor.svg'
          alt='Papírnictví Přístav'
          class='w-full'
        />
      </div>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Pellow.svg'
          alt='Cukrárna Pelikán'
          class='w-full'
        />
      </div>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Tidewater.svg'
          alt='Časopis Čtvrť'
          class='w-full'
        />
      </div>
    </div>
    <div
      class='col-start-1 mt-4 pt-4 col-end-13 flex justify-center space-x-2'
    >
      <button
        class='whitespace-nowrap text-stone-800 text-sm font-semibold bg-transparent border border-stone-200 hover:bg-stone-100 transition-colors duration-100 py-2 px-5 rounded-md'
      >
        Zastavte se na kávu
      </button>
      <button
        class='whitespace-nowrap text-stone-800 text-sm font-semibold bg-yellow-400 hover:bg-yellow-500 transition-colors duration-100 py-2 px-5 rounded-md'
      >
        Zastavte se na kávu
      </button>
    </div>
  </div>
</section>
