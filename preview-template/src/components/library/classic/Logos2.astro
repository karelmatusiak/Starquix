---
/**
 * @category Logos
 * @theme classic
 * @name Logos2
 */
---
<section
  class='py-8 px-2 grid grid-cols-1 gap-4 bg-stone-50 sm:py-12 sm:px-4 sm:gap-8 md:grid-cols-12 md:py-16 md:px-8 lg:px-16 lg:py-16'
>
  <div class='col-start-1 col-end-13'>
    <h2
      class='w-full text-center text-xl font-semibold text-gray-800 sm:text-2xl md:text-3xl'
    >
      Pečeme pro lidi z okolí
    </h2>
    <p
      class='w-full text-center text-base text-gray-500 sm:text-lg md:text-xl mt-2 sm:mt-3'
    >
      Od sousedů z ulice po celou čtvrť
    </p>
    <div class='w-full grid grid-cols-2 gap-4 mt-6 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 md:gap-8 md:mt-4'>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Coastline.svg'
          alt='Výlety Na Nábřeží'
          class='w-full'
        />
      </div>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Kettle.svg'
          alt='Čajovna Konvice'
          class='w-full'
        />
      </div>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Nordvik.svg'
          alt='Statek Severák'
          class='w-full'
        />
      </div>
      <div class='flex items-center justify-center'>
        <img
          src='/assets/logos/Halden.svg'
          alt='Keramika Hrádek'
          class='w-full'
        />
      </div>
    </div>
    <div
      class='col-start-1 mt-6 pt-4 col-end-13 flex flex-col gap-3 justify-center sm:flex-row sm:space-x-2 md:mt-4'
    >
      <button
        class='whitespace-nowrap text-stone-800 text-sm font-semibold bg-transparent border border-stone-200 hover:bg-stone-100 transition-colors duration-100 py-2 px-4 rounded-md sm:px-5'
      >
        <span>Zastavte se na kávu</span>
      </button>
      <button
        class='whitespace-nowrap text-stone-800 text-sm font-semibold bg-yellow-400 hover:bg-yellow-500 transition-colors duration-100 py-2 px-4 rounded-md sm:px-5'
      >
        <span>Zastavte se na kávu</span>
      </button>
    </div>
  </div>
</section>
