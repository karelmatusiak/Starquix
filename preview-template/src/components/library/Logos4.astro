---
/**
 * @category Logos
 * @theme starquix
 * @name Logos4
 */
---
<section class='bg-stone-50 px-4 py-20 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <div class='grid grid-cols-1 gap-10 xl:grid-cols-12 xl:items-center xl:gap-8'>
    <div class='flex flex-col items-start gap-4 md:max-w-xl xl:col-span-4 xl:max-w-none'>
      <h2 class='m-0 font-sans text-xl font-semibold text-stone-900 text-balance dark:text-stone-50'>Běžné Astro ve vlastních repozitářích</h2>
      <p class='m-0 font-sans text-lg leading-relaxed text-stone-600 text-pretty dark:text-stone-400'>Web pekárny je projekt Astro na účtu GitHub. Obvyklý postup ho sestaví a zveřejní.</p>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Ukázka webu</a>
    </div>
    <div class='grid grid-cols-2 items-center gap-x-4 border-0 border-t border-solid border-stone-200 pt-6 md:grid-cols-3 md:gap-x-6 xl:col-span-7 xl:col-start-6 xl:border-l xl:border-t-0 xl:pl-12 xl:pt-0 dark:border-stone-700'>
      <img class='block h-auto w-full max-w-[11rem] justify-self-center dark:brightness-125' src='/assets/logos/Nordvik.svg' alt='Statek Severák' width='256' height='148' />
      <img class='block h-auto w-full max-w-[11rem] justify-self-center dark:brightness-125' src='/assets/logos/Kettle.svg' alt='Čajovna Konvice' width='256' height='148' />
      <img class='block h-auto w-full max-w-[11rem] justify-self-center dark:brightness-125' src='/assets/logos/Tidewater.svg' alt='Vinotéka U Vody' width='256' height='148' />
      <img class='block h-auto w-full max-w-[11rem] justify-self-center dark:brightness-125' src='/assets/logos/Lumen.svg' alt='Studio Lumen' width='256' height='148' />
      <img class='block h-auto w-full max-w-[11rem] justify-self-center dark:brightness-125' src='/assets/logos/Coastline.svg' alt='Výlety Na Nábřeží' width='256' height='148' />
      <img class='block h-auto w-full max-w-[11rem] justify-self-center dark:brightness-125' src='/assets/logos/PaperHarbor.svg' alt='Papírnictví Přístav' width='256' height='148' />
    </div>
  </div>
</section>
