---
/**
 * @category Footer
 * @theme starquix
 * @name Footer
 */
---
<footer class='flex flex-col gap-12 bg-yellow-400 px-4 pb-6 pt-20 md:gap-16 md:px-10 md:pt-28 xl:px-16'>
  <div class='flex flex-col items-start gap-8 md:flex-row md:items-end md:justify-between md:gap-10'>
    <p class='m-0 font-sans text-[2.75rem] font-semibold leading-[0.95] tracking-[-0.04em] text-stone-900 text-balance md:text-6xl xl:text-[5rem]'>Z pece rovnou na pult.</p>
    <a href='#' class='inline-flex min-h-12 shrink-0 items-center justify-center rounded-lg bg-stone-900 px-6 font-sans text-base font-semibold text-yellow-400 no-underline transition-colors duration-150 ease-out hover:bg-stone-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900'>Založit stránku</a>
  </div>
  <div class='flex flex-col gap-2 border-0 border-t border-solid border-stone-900/20 pt-4 md:flex-row md:items-center md:justify-between'>
    <nav class='flex flex-wrap gap-x-6'>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900'>Pečivo</a>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900'>Ceník</a>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900'>Nabídka</a>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900'>Novinky z pece</a>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900'>Kontakt</a>
    </nav>
    <div class='flex flex-wrap items-center gap-x-6'>
      <p class='m-0 font-sans text-sm text-stone-800'>© 2026 Pekárna Na Růžku</p>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-sm text-stone-800 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900'>Soukromí</a>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-sm text-stone-800 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900'>Podmínky</a>
    </div>
  </div>
  <img class='block h-auto w-full' src='/assets/logos/logo-placeholder.svg' alt='Pekárna Na Růžku' width='89' height='30' />
</footer>
