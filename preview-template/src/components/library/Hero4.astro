---
/**
 * @category Hero
 * @theme starquix
 * @name Hero4
 */
---
<section class='flex flex-col gap-10 bg-stone-50 px-4 pb-20 pt-12 md:gap-12 md:px-10 md:pb-28 md:pt-16 xl:px-16 xl:pb-32 xl:pt-20 dark:bg-stone-900'>
  <h1 class='m-0 font-sans text-[3rem] font-semibold leading-[0.92] tracking-[-0.045em] text-stone-900 text-balance md:text-[5.5rem] xl:text-[8rem] dark:text-stone-50'>Pekárna a kavárna na rohu</h1>
  <div class='grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-x-6 md:gap-y-12 xl:gap-x-8 xl:gap-y-8'>
    <div class='flex flex-col gap-6 md:col-span-12 md:row-start-1 md:max-w-xl xl:col-span-4 xl:col-start-9'>
      <p class='m-0 font-sans text-lg leading-relaxed text-stone-600 text-pretty dark:text-stone-400'>Co poskládáte na plátně, uloží se jako soubory .astro s třídami Tailwind. Otevřete složku v libovolném editoru kódu a soubory se čtou jako vaše vlastní.</p>
      <div class='flex flex-col gap-3 sm:flex-row sm:flex-wrap'>
        <a href='#' class='inline-flex min-h-12 items-center justify-center rounded-lg bg-yellow-400 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-yellow-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-yellow-400'>Založit stránku</a>
        <a href='#' class='inline-flex min-h-12 items-center justify-center rounded-lg bg-stone-200 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-stone-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:bg-stone-700 dark:text-stone-50 dark:hover:bg-stone-600 dark:focus-visible:outline-stone-50'>Zobrazit kód</a>
      </div>
    </div>
    <img class='block aspect-[5/4] h-auto w-full rounded-[1.25rem] object-cover md:col-span-8 md:row-start-2 md:rounded-[2rem] xl:col-span-8 xl:col-start-1 xl:row-span-2 xl:row-start-1' src='/assets/images/content/spaceship1.webp' alt='Krémová vesmírná loď na přistávacích nohách nad polem červených květů' width='2400' height='1920' />
    <img class='block aspect-square h-auto w-1/2 justify-self-end rounded-2xl object-cover md:col-span-4 md:col-start-9 md:row-start-2 md:w-full md:self-end xl:row-start-2' src='/assets/images/content/snippet.webp' alt='Obrazovka retro konzole zobrazující řádky kódu Astro' width='1024' height='1024' />
  </div>
</section>
