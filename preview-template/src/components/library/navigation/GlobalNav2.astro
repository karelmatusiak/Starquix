      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Nabídka</a>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Deník</a>
    </div>
    <a href='#' class='inline-flex min-h-12 items-center justify-center justify-self-end whitespace-nowrap rounded-lg bg-yellow-400 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-yellow-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-yellow-400'>Založit stránku</a>
  </div>
