---
/**
 * @category Navigation
 * @theme starquix
 * @name GlobalNav2
 */
---
<nav class='sticky top-0 z-10 bg-stone-50 p-2 md:p-3 dark:bg-stone-900' aria-label='Main'>
  <div class='flex flex-wrap items-center justify-between gap-x-6 rounded-2xl bg-white py-2 pl-4 pr-2 shadow-[0_1px_2px_rgb(28_25_23/0.06),0_16px_40px_-16px_rgb(28_25_23/0.18)] ring-1 ring-stone-200 md:grid md:grid-cols-[1fr_auto_1fr] md:pl-6 dark:bg-stone-800 dark:ring-stone-700'>
    <a href='/' class='inline-flex min-h-11 items-center justify-self-start rounded-lg no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-stone-50'>
      <img class='block dark:invert' src='/assets/logos/logo-placeholder.svg' alt='Pekárna Na Růžku' width='89' height='30' />
    </a>
    <div class='order-last mt-2 flex w-full flex-wrap gap-x-5 border-0 border-t border-solid border-stone-200 pt-1 md:order-none md:mt-0 md:w-auto md:gap-x-8 md:border-t-0 md:pt-0 dark:border-stone-700'>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Co pečeme</a>
