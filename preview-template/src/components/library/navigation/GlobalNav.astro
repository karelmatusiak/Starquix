---
/**
 * @category Navigation
 * @theme starquix
 * @name GlobalNav
 */
---
<header class='sticky top-0 z-50 border-0 border-b border-solid border-stone-200 bg-stone-50 dark:border-stone-700 dark:bg-stone-900'>
  <nav class='relative flex min-h-16 items-center justify-between gap-6 px-4 py-2 md:grid md:grid-cols-[1fr_auto_1fr] md:px-10 xl:px-16' aria-label='Main'>
    <div class='hidden items-center gap-x-6 md:flex xl:gap-x-8'>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Co pečeme</a>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Ceník</a>
      <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Deník</a>
    </div>
    <a href='/' class='inline-flex min-h-11 items-center rounded-lg font-sans text-2xl font-semibold tracking-[-0.04em] text-stone-900 no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Pekárna Na Růžku</a>
    <div class='hidden justify-end md:flex'>
      <a href='#' class='inline-flex min-h-12 items-center justify-center whitespace-nowrap rounded-lg bg-yellow-400 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-yellow-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-yellow-400'>Založit stránku</a>
    </div>
    <details class='group md:hidden'>
      <summary class='flex min-h-11 cursor-pointer list-none items-center rounded-lg bg-stone-200 px-4 font-sans text-base font-semibold text-stone-900 transition-colors duration-150 ease-out hover:bg-stone-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 group-open:bg-stone-300 dark:bg-stone-700 dark:text-stone-50 dark:hover:bg-stone-600 dark:focus-visible:outline-stone-50 dark:group-open:bg-stone-600 [&::-webkit-details-marker]:hidden'>Nabídka</summary>
      <div class='absolute inset-x-0 top-full flex flex-col border-0 border-b border-solid border-stone-200 bg-stone-50 px-4 pb-6 dark:border-stone-700 dark:bg-stone-900'>
        <a href='#' class='flex min-h-16 items-center border-0 border-t border-solid border-stone-200 font-sans text-3xl font-semibold tracking-[-0.03em] text-stone-900 no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:border-stone-700 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Co pečeme</a>
        <a href='#' class='flex min-h-16 items-center border-0 border-t border-solid border-stone-200 font-sans text-3xl font-semibold tracking-[-0.03em] text-stone-900 no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:border-stone-700 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Ceník</a>
        <a href='#' class='flex min-h-16 items-center border-0 border-t border-solid border-stone-200 font-sans text-3xl font-semibold tracking-[-0.03em] text-stone-900 no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:border-stone-700 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Deník</a>
        <a href='#' class='mt-4 inline-flex min-h-12 items-center justify-center rounded-lg bg-yellow-400 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-yellow-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-yellow-400'>Založit stránku</a>
      </div>
    </details>
  </nav>
</header>
