---
/**
 * @category Logos
 * @theme starquix
 * @name Logos3
 */
---
<section class='flex flex-col gap-8 bg-stone-50 px-4 py-20 md:gap-10 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <div class='grid grid-cols-2 items-center gap-x-6 md:grid-cols-4 md:gap-x-10 md:gap-y-4'>
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/PaperHarbor.svg' alt='Papírnictví Přístav' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Halden.svg' alt='Keramika Hrádek' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Pellow.svg' alt='Cukrárna Pelikán' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Nordvik.svg' alt='Statek Severák' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Coastline.svg' alt='Výlety Na Nábřeží' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Tidewater.svg' alt='Vinotéka U Vody' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Kettle.svg' alt='Čajovna Konvice' width='256' height='148' />
    <img class='block h-auto w-full max-w-[12rem] justify-self-center dark:brightness-125' src='/assets/logos/Lumen.svg' alt='Studio Lumen' width='256' height='148' />
  </div>
  <div class='flex flex-col items-start gap-2 border-0 border-t border-solid border-stone-200 pt-6 md:flex-row md:items-center md:justify-between md:gap-10 dark:border-stone-700'>
    <p class='m-0 font-sans text-lg leading-relaxed text-stone-600 text-pretty md:max-w-2xl dark:text-stone-400'>Lidé z těchto podniků k nám chodí pro pečivo a každý má svou stálou objednávku.</p>
    <a href='#' class='inline-flex min-h-11 shrink-0 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Co říkají sousedé</a>
  </div>
</section>
