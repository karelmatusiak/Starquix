---
/**
 * @category Logos
 * @theme starquix
 * @name Logos2
 */
---
<section class='flex flex-col gap-12 bg-stone-50 px-4 py-20 md:gap-16 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <div class='grid grid-cols-1 gap-5 md:grid-cols-12 md:items-end md:gap-10'>
    <h2 class='m-0 font-sans text-[2.75rem] font-semibold leading-[0.95] tracking-[-0.04em] text-stone-900 text-balance md:col-span-7 md:text-6xl xl:text-[4rem] dark:text-stone-50'>Z pekárny Na Růžku</h2>
    <p class='m-0 font-sans text-lg leading-relaxed text-stone-600 text-pretty md:col-span-5 dark:text-stone-400'>Nabídku, otevírací dobu a novinky upravujeme na plátně a publikujeme to jako běžné Astro.</p>
  </div>
  <div class='grid grid-cols-2 border-0 border-t border-solid border-stone-200 md:grid-cols-4 dark:border-stone-700'>
    <div class='flex items-center justify-center border-0 border-b border-r border-solid border-stone-200 px-4 py-2 md:py-4 dark:border-stone-700'>
      <img class='block h-auto w-full max-w-[11rem] dark:brightness-125' src='/assets/logos/Kettle.svg' alt='Čajovna Konvice' width='256' height='148' />
    </div>
    <div class='flex items-center justify-center border-0 border-b border-solid border-stone-200 px-4 py-2 md:border-r md:py-4 dark:border-stone-700'>
      <img class='block h-auto w-full max-w-[11rem] dark:brightness-125' src='/assets/logos/PaperHarbor.svg' alt='Papírnictví Přístav' width='256' height='148' />
    </div>
    <div class='flex items-center justify-center border-0 border-b border-r border-solid border-stone-200 px-4 py-2 md:py-4 dark:border-stone-700'>
      <img class='block h-auto w-full max-w-[11rem] dark:brightness-125' src='/assets/logos/Lumen.svg' alt='Studio Lumen' width='256' height='148' />
    </div>
    <div class='flex items-center justify-center border-0 border-b border-solid border-stone-200 px-4 py-2 md:py-4 dark:border-stone-700'>
      <img class='block h-auto w-full max-w-[11rem] dark:brightness-125' src='/assets/logos/Tidewater.svg' alt='Vinotéka U Vody' width='256' height='148' />
    </div>
    <div class='flex items-center justify-center border-0 border-b border-r border-solid border-stone-200 px-4 py-2 md:py-4 dark:border-stone-700'>
      <img class='block h-auto w-full max-w-[11rem] dark:brightness-125' src='/assets/logos/Nordvik.svg' alt='Statek Severák' width='256' height='148' />
    </div>
    <div class='flex items-center justify-center border-0 border-b border-solid border-stone-200 px-4 py-2 md:border-r md:py-4 dark:border-stone-700'>
      <img class='block h-auto w-full max-w-[11rem] dark:brightness-125' src='/assets/logos/Coastline.svg' alt='Výlety Na Nábřeží' width='256' height='148' />
    </div>
    <div class='flex items-center justify-center border-0 border-b border-r border-solid border-stone-200 px-4 py-2 md:py-4 dark:border-stone-700'>
      <img class='block h-auto w-full max-w-[11rem] dark:brightness-125' src='/assets/logos/Pellow.svg' alt='Cukrárna Pelikán' width='256' height='148' />
    </div>
    <div class='flex items-center justify-center border-0 border-b border-solid border-stone-200 px-4 py-2 md:py-4 dark:border-stone-700'>
      <img class='block h-auto w-full max-w-[11rem] dark:brightness-125' src='/assets/logos/Halden.svg' alt='Keramika Hrádek' width='256' height='148' />
    </div>
  </div>
</section>
