---
/**
 * @category Feature
 * @theme starquix
 * @name CzHodiny
 */
---
<section id='hodiny' class='bg-stone-50 px-4 py-16 md:px-10 md:py-24 dark:bg-stone-900'>
  <h2 class='m-0 font-sans text-3xl font-semibold text-stone-900 md:text-5xl dark:text-stone-50'>Otevírací doba</h2>
  <p class='m-0 mt-3 font-sans text-lg text-stone-600 dark:text-stone-400' data-sq-firma='openingHours'>Po–Pá 8:00–17:00, So 9:00–12:00</p>
  <dl class='mt-6 max-w-md font-sans text-base text-stone-900 dark:text-stone-50'>
    <div data-sq-day='Mo' class='flex justify-between border-0 border-b border-solid border-stone-200 py-2 dark:border-stone-700'><dt>Pondělí</dt><dd class='m-0'>8:00–17:00</dd></div>
    <div data-sq-day='Tu' class='flex justify-between border-0 border-b border-solid border-stone-200 py-2 dark:border-stone-700'><dt>Úterý</dt><dd class='m-0'>8:00–17:00</dd></div>
    <div data-sq-day='We' class='flex justify-between border-0 border-b border-solid border-stone-200 py-2 dark:border-stone-700'><dt>Středa</dt><dd class='m-0'>8:00–17:00</dd></div>
    <div data-sq-day='Th' class='flex justify-between border-0 border-b border-solid border-stone-200 py-2 dark:border-stone-700'><dt>Čtvrtek</dt><dd class='m-0'>8:00–17:00</dd></div>
    <div data-sq-day='Fr' class='flex justify-between border-0 border-b border-solid border-stone-200 py-2 dark:border-stone-700'><dt>Pátek</dt><dd class='m-0'>8:00–17:00</dd></div>
    <div data-sq-day='Sa' class='flex justify-between border-0 border-b border-solid border-stone-200 py-2 dark:border-stone-700'><dt>Sobota</dt><dd class='m-0'>9:00–12:00</dd></div>
    <div data-sq-day='Su' class='flex justify-between py-2'><dt>Neděle</dt><dd class='m-0'>zavřeno</dd></div>
  </dl>
</section>
