---
/**
 * @category Team
 * @theme starquix
 * @name Team
 */
---
<section class='bg-stone-50 px-4 py-20 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <div class='flex flex-col gap-12 md:gap-16'>
    <div class='grid grid-cols-1 gap-5 md:grid-cols-12 md:items-end md:gap-10'>
      <h2 class='m-0 font-sans text-[2.75rem] font-semibold leading-[0.95] tracking-[-0.04em] text-stone-900 text-balance md:col-span-7 md:text-6xl xl:text-[4rem] dark:text-stone-50'>Lidé z Pekárny Na Růžku</h2>
      <p class='m-0 font-sans text-lg leading-relaxed text-stone-600 text-pretty md:col-span-5 dark:text-stone-400'>Roky jsme pekli pro sousedy, než jsme otevřeli Pekárnu Na Růžku. Na každý e-mail pořád odpovídáme sami.</p>
    </div>
    <div class='grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-4 md:gap-x-8 md:gap-y-14'>
      <div class='flex flex-col items-start gap-4'>
        <img class='block h-20 w-20 rounded-2xl object-cover md:h-24 md:w-24' src='/assets/userpics/userpic01.webp' alt='Portrét Ivany Marešové' width='96' height='96' />
        <div class='flex flex-col gap-1'>
          <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Ines Moreau</h3>
          <p class='m-0 font-sans text-base text-stone-600 dark:text-stone-400'>Zakladatelka, pečivo</p>
        </div>
      </div>
      <div class='flex flex-col items-start gap-4'>
        <img class='block h-20 w-20 rounded-2xl object-cover md:h-24 md:w-24' src='/assets/userpics/userpic05.webp' alt='Portrét Amálie Němcové' width='96' height='96' />
        <div class='flex flex-col gap-1'>
          <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Amálie Němcová</h3>
          <p class='m-0 font-sans text-base text-stone-600 dark:text-stone-400'>Cukrářka</p>
        </div>
      </div>
      <div class='flex flex-col items-start gap-4'>
        <img class='block h-20 w-20 rounded-2xl object-cover md:h-24 md:w-24' src='/assets/userpics/userpic06.webp' alt='Portrét Jana Nováka' width='96' height='96' />
        <div class='flex flex-col gap-1'>
          <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Jan Novák</h3>
          <p class='m-0 font-sans text-base text-stone-600 dark:text-stone-400'>běhové prostředí Astro</p>
        </div>
      </div>
      <div class='flex flex-col items-start gap-4'>
        <img class='block h-20 w-20 rounded-2xl object-cover md:h-24 md:w-24' src='/assets/userpics/userpic07.webp' alt='Portrét Nory Hájkové' width='96' height='96' />
        <div class='flex flex-col gap-1'>
          <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Noor Haddad</h3>
          <p class='m-0 font-sans text-base text-stone-600 dark:text-stone-400'>Pekař</p>
        </div>
      </div>
      <div class='flex flex-col items-start gap-4'>
        <img class='block h-20 w-20 rounded-2xl object-cover md:h-24 md:w-24' src='/assets/userpics/userpic02.webp' alt='Portrét Oskara Linharta' width='96' height='96' />
        <div class='flex flex-col gap-1'>
          <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Oskar Lind</h3>
          <p class='m-0 font-sans text-base text-stone-600 dark:text-stone-400'>Pekař na ranní směně</p>
        </div>
      </div>
      <div class='flex flex-col items-start gap-4'>
        <img class='block h-20 w-20 rounded-2xl object-cover md:h-24 md:w-24' src='/assets/userpics/userpic03.webp' alt='Portrét Růženy Bendové' width='96' height='96' />
        <div class='flex flex-col gap-1'>
          <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Rosa Bianchi</h3>
          <p class='m-0 font-sans text-base text-stone-600 dark:text-stone-400'>Naše receptury</p>
        </div>
      </div>
      <div class='flex flex-col items-start gap-4'>
        <img class='block h-20 w-20 rounded-2xl object-cover md:h-24 md:w-24' src='/assets/userpics/userpic10.webp' alt='Portrét Justýny Tanzerové' width='96' height='96' />
        <div class='flex flex-col gap-1'>
          <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Yuki Tanaka</h3>
          <p class='m-0 font-sans text-base text-stone-600 dark:text-stone-400'>Jak objednat</p>
        </div>
      </div>
      <div class='flex flex-col items-start gap-4'>
        <img class='block h-20 w-20 rounded-2xl object-cover md:h-24 md:w-24' src='/assets/userpics/userpic08.webp' alt='Portrét Kláry Jandové' width='96' height='96' />
        <div class='flex flex-col gap-1'>
          <h3 class='m-0 font-sans text-lg font-semibold text-stone-900 dark:text-stone-50'>Klára Jandová</h3>
          <p class='m-0 font-sans text-base text-stone-600 dark:text-stone-400'>Péče o hosty</p>
        </div>
      </div>
    </div>
  </div>
</section>
