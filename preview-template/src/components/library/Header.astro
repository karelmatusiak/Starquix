---
/**
 * @category Header
 * @theme starquix
 * @name Header
 */
---
<header class='flex flex-wrap items-center justify-between gap-x-8 border-0 border-b border-solid border-stone-200 bg-stone-50 px-4 pt-3 md:px-10 xl:flex-nowrap xl:gap-x-12 xl:px-16 xl:py-4 dark:border-stone-700 dark:bg-stone-900'>
  <a href='/' class='inline-flex min-h-11 shrink-0 items-center rounded-lg no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-stone-50'>
    <img class='block dark:invert' src='/assets/logos/logo-placeholder.svg' alt='Pekárna Na Růžku' width='89' height='30' />
  </a>
  <nav class='order-last mt-3 flex w-full flex-wrap gap-x-5 border-0 border-t border-solid border-stone-200 py-1 md:gap-x-8 xl:order-none xl:mt-0 xl:w-auto xl:flex-1 xl:border-t-0 xl:py-0 dark:border-stone-700' aria-label='Main'>
    <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Co pečeme</a>
    <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Ceník</a>
    <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Nabídka</a>
    <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:text-stone-50 dark:focus-visible:outline-stone-50'>Deník</a>
    <a href='#' class='inline-flex min-h-11 items-center font-sans text-base font-medium text-stone-900 no-underline underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 md:ml-auto dark:text-stone-50 dark:focus-visible:outline-stone-50'>Přihlásit se</a>
  </nav>
  <a href='#' class='inline-flex min-h-12 shrink-0 items-center justify-center whitespace-nowrap rounded-lg bg-yellow-400 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-yellow-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-yellow-400'>Založit stránku</a>
</header>
