---
/**
 * @category Team
 * @theme starquix
 * @name Team4
 */
---
<section class='bg-stone-50 px-4 py-20 md:px-10 md:py-28 xl:px-16 xl:py-32 dark:bg-stone-900'>
  <div class='flex flex-col gap-12 md:gap-16'>
    <h2 class='m-0 font-sans text-[2.75rem] font-semibold leading-[0.95] tracking-[-0.04em] text-stone-900 text-balance md:text-6xl xl:text-[4rem] dark:text-stone-50'>Peče malý tým</h2>
    <div class='grid grid-cols-5 gap-x-2 gap-y-6 md:gap-x-6 md:gap-y-8 xl:flex xl:justify-between'>
      <div class='flex flex-col items-start gap-3'>
        <img class='block h-14 w-14 rounded-full object-cover md:h-20 md:w-20' src='/assets/userpics/userpic01.webp' alt='Portrét Ivany Marešové' width='80' height='80' />
        <p class='m-0 font-sans text-sm font-medium text-stone-900 dark:text-stone-50'>Ines</p>
      </div>
      <div class='flex flex-col items-start gap-3'>
        <img class='block h-14 w-14 rounded-full object-cover md:h-20 md:w-20' src='/assets/userpics/userpic02.webp' alt='Portrét Oskara Linharta' width='80' height='80' />
        <p class='m-0 font-sans text-sm font-medium text-stone-900 dark:text-stone-50'>Oskar</p>
      </div>
      <div class='flex flex-col items-start gap-3'>
        <img class='block h-14 w-14 rounded-full object-cover md:h-20 md:w-20' src='/assets/userpics/userpic03.webp' alt='Portrét Růženy Bendové' width='80' height='80' />
        <p class='m-0 font-sans text-sm font-medium text-stone-900 dark:text-stone-50'>Rosa</p>
      </div>
      <div class='flex flex-col items-start gap-3'>
        <img class='block h-14 w-14 rounded-full object-cover md:h-20 md:w-20' src='/assets/userpics/userpic04.webp' alt='Portrét Tobiáše Krause' width='80' height='80' />
        <p class='m-0 font-sans text-sm font-medium text-stone-900 dark:text-stone-50'>Tobias</p>
      </div>
      <div class='flex flex-col items-start gap-3'>
        <img class='block h-14 w-14 rounded-full object-cover md:h-20 md:w-20' src='/assets/userpics/userpic05.webp' alt='Portrét Amálie Němcové' width='80' height='80' />
        <p class='m-0 font-sans text-sm font-medium text-stone-900 dark:text-stone-50'>Amálie</p>
      </div>
      <div class='flex flex-col items-start gap-3'>
        <img class='block h-14 w-14 rounded-full object-cover md:h-20 md:w-20' src='/assets/userpics/userpic06.webp' alt='Portrét Jana Nováka' width='80' height='80' />
        <p class='m-0 font-sans text-sm font-medium text-stone-900 dark:text-stone-50'>Jan</p>
      </div>
      <div class='flex flex-col items-start gap-3'>
        <img class='block h-14 w-14 rounded-full object-cover md:h-20 md:w-20' src='/assets/userpics/userpic07.webp' alt='Portrét Nory Hájkové' width='80' height='80' />
        <p class='m-0 font-sans text-sm font-medium text-stone-900 dark:text-stone-50'>Noor</p>
      </div>
      <div class='flex flex-col items-start gap-3'>
        <img class='block h-14 w-14 rounded-full object-cover md:h-20 md:w-20' src='/assets/userpics/userpic08.webp' alt='Portrét Kláry Jandové' width='80' height='80' />
        <p class='m-0 font-sans text-sm font-medium text-stone-900 dark:text-stone-50'>Klára</p>
      </div>
      <div class='flex flex-col items-start gap-3'>
        <img class='block h-14 w-14 rounded-full object-cover md:h-20 md:w-20' src='/assets/userpics/userpic09.webp' alt='Portrét Pavla Soukupa' width='80' height='80' />
        <p class='m-0 font-sans text-sm font-medium text-stone-900 dark:text-stone-50'>Pablo</p>
      </div>
      <div class='flex flex-col items-start gap-3'>
        <img class='block h-14 w-14 rounded-full object-cover md:h-20 md:w-20' src='/assets/userpics/userpic10.webp' alt='Portrét Justýny Tanzerové' width='80' height='80' />
        <p class='m-0 font-sans text-sm font-medium text-stone-900 dark:text-stone-50'>Yuki</p>
      </div>
    </div>
    <div class='flex flex-col items-start gap-6 border-0 border-t border-solid border-stone-200 pt-8 md:flex-row md:items-center md:justify-between md:gap-10 dark:border-stone-700'>
      <p class='m-0 font-sans text-2xl leading-snug tracking-[-0.02em] text-stone-900 text-pretty md:text-[1.75rem] dark:text-stone-50'>Hledáme druhého pekaře. <span class='text-stone-500 dark:text-stone-400'>V pekárně na rohu, směny od 6.30.</span></p>
      <a href='#' class='inline-flex min-h-12 shrink-0 items-center justify-center rounded-lg bg-yellow-400 px-6 font-sans text-base font-semibold text-stone-900 no-underline transition-colors duration-150 ease-out hover:bg-yellow-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 dark:focus-visible:outline-yellow-400'>Ranní směny od 6.30</a>
    </div>
  </div>
</section>
